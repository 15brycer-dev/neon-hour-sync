{
  "name": "PowerHourSession",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "standard",
        "century",
        "custom"
      ]
    },
    "playlist_id": {
      "type": "string"
    },
    "playlist_name": {
      "type": "string"
    },
    "shots_completed": {
      "type": "integer",
      "minimum": 0
    },
    "total_shots": {
      "type": "integer",
      "minimum": 1
    },
    "interval_seconds": {
      "type": "integer",
      "minimum": 5
    },
    "completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "mode",
    "playlist_name",
    "shots_completed",
    "total_shots",
    "completed"
  ]
}